{
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Read(./.env.local)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/no-build-over-dev-server.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
