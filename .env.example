# Locus reads secrets from here. Copy to .env.local and fill in what you need.
# .env.local is gitignored; .env.example (this file) is tracked and must never
# contain a real key.

# Which database file to use. Defaults to data/locus.db.
# LOCUS_DB=data/locus.db

# AI provider keys. Only needed for the "assisted" and "full" levels, which you
# choose in Settings inside the app. At the default "local" level Locus makes no
# network calls and none of these are read.
#
# You can paste a key into Settings instead, which writes it here for you.
# Either way it stays out of the database.

# LOCUS_AI_ANTHROPIC=sk-ant-...
# LOCUS_AI_OPENAI=sk-...
# LOCUS_AI_GROQ=gsk_...

# Only for an Anthropic identity-linked key, which must say which workspace it
# acts in. An ordinary key does not need this. You can also set it in Settings.
# LOCUS_AI_ANTHROPIC_WORKSPACE=
